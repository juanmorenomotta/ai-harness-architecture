# GENERADO por scripts/sync-adapters.sh — NO EDITAR A MANO.
# Fuente de verdad: .harness/models.yaml
# R9: aquí solo van NOMBRES de variables, jamás valores de credenciales.

# Modelo por rol (formato: HARNESS_MODEL_<ROL_MAYUSCULAS>)
HARNESS_MODEL_SDD_DEVELOPER=deepseek-flash
HARNESS_PROVIDER_SDD_DEVELOPER=deepseek
HARNESS_REASONING_SDD_DEVELOPER=medium
HARNESS_MODEL_SDD_INIT=deepseek-v4-pro
HARNESS_PROVIDER_SDD_INIT=deepseek
HARNESS_REASONING_SDD_INIT=high
HARNESS_MODEL_SDD_SECURITY_REVIEWER=deepseek-v4-pro
HARNESS_PROVIDER_SDD_SECURITY_REVIEWER=deepseek
HARNESS_REASONING_SDD_SECURITY_REVIEWER=high
HARNESS_MODEL_SDD_TECH_LEAD=deepseek-v4-pro
HARNESS_PROVIDER_SDD_TECH_LEAD=deepseek
HARNESS_REASONING_SDD_TECH_LEAD=high
HARNESS_MODEL_SDD_VERIFIER=deepseek-v4-pro
HARNESS_PROVIDER_SDD_VERIFIER=deepseek
HARNESS_REASONING_SDD_VERIFIER=high

# Variables de entorno que DEBE tener el shell (los valores no viven en el repo)
# requiere: DEEPSEEK_API_KEY