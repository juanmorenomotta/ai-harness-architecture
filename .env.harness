# GENERADO por scripts/sync-adapters.sh — NO EDITAR A MANO.
# Fuente de verdad: .harness/models.yaml
# R9: aquí solo van NOMBRES de variables, jamás valores de credenciales.

# Modelo por rol (formato: HARNESS_MODEL_<ROL_MAYUSCULAS>)
HARNESS_MODEL_HARNESS_MAINTAINER=gpt-5.3-codex
HARNESS_PROVIDER_HARNESS_MAINTAINER=
HARNESS_REASONING_HARNESS_MAINTAINER=medium
HARNESS_MODEL_SDD_DEVELOPER=gpt-5.3-codex
HARNESS_PROVIDER_SDD_DEVELOPER=
HARNESS_REASONING_SDD_DEVELOPER=medium
HARNESS_MODEL_SDD_INIT=claude-sonnet-5
HARNESS_PROVIDER_SDD_INIT=
HARNESS_REASONING_SDD_INIT=high
HARNESS_MODEL_SDD_SECURITY_REVIEWER=claude-sonnet-5
HARNESS_PROVIDER_SDD_SECURITY_REVIEWER=
HARNESS_REASONING_SDD_SECURITY_REVIEWER=high
HARNESS_MODEL_SDD_TECH_LEAD=gpt-5.6-terra
HARNESS_PROVIDER_SDD_TECH_LEAD=
HARNESS_REASONING_SDD_TECH_LEAD=high
HARNESS_MODEL_SDD_VERIFIER=DeepSeek V4 Flash (deepseek)
HARNESS_PROVIDER_SDD_VERIFIER=
HARNESS_REASONING_SDD_VERIFIER=high

# Variables de entorno que DEBE tener el shell (los valores no viven en el repo)